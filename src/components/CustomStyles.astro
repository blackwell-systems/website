---
// Typography + color unified with the blog (blog.blackwell-systems.com):
// Fraunces (headings) + IBM Plex Sans (body) + JetBrains Mono (code),
// charcoal #1d1e20 surface, slate-blue #6fa2c9 accent.
// Fonts loaded via Google Fonts to match the blog exactly (no npm install needed).
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,700;9..144,900&family=IBM+Plex+Sans:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
/>

<style is:inline>
  :root {
    --aw-font-sans: 'IBM Plex Sans';
    --aw-font-serif: 'Fraunces';
    --aw-font-heading: 'Fraunces';

    --aw-color-primary: rgb(111 162 201);
    --aw-color-secondary: rgb(143 187 220);
    --aw-color-accent: rgb(143 187 220);

    --aw-color-text-heading: rgb(240 240 240);
    --aw-color-text-default: rgb(212 212 213);
    --aw-color-text-muted: rgb(183 184 186);
    --aw-color-bg-page: rgb(29 30 32);

    --aw-color-bg-page-dark: rgb(29 30 32);

    ::selection {
      background-color: rgb(111 162 201 / 35%);
    }
  }

  .dark {
    --aw-font-sans: 'IBM Plex Sans';
    --aw-font-serif: 'Fraunces';
    --aw-font-heading: 'Fraunces';

    --aw-color-primary: rgb(111 162 201);
    --aw-color-secondary: rgb(143 187 220);
    --aw-color-accent: rgb(143 187 220);

    --aw-color-text-heading: rgb(240 240 240);
    --aw-color-text-default: rgb(212 212 213);
    --aw-color-text-muted: rgb(183 184 186);
    --aw-color-bg-page: rgb(29 30 32);

    ::selection {
      background-color: rgb(111 162 201 / 35%);
      color: rgb(240 240 240);
    }
  }
</style>
