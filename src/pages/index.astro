---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Steps from '~/components/widgets/Steps.astro';

const metadata = {
  title: 'Blackwell Systems — AI Infrastructure & Consulting',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Audit',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:bolt',
      },
      { text: 'View on GitHub', href: 'https://github.com/blackwell-systems', target: '_blank', icon: 'tabler:brand-github' },
    ]}
  >
    <Fragment slot="title">
      We cut your AI token costs by <span class="text-accent dark:text-white">50-79%</span>. Measurably.
    </Fragment>

    <Fragment slot="subtitle">
      Blackwell Systems builds production-grade developer infrastructure for the agentic AI stack.
      Founded by Dayna Blackwell, a systems engineer with 5 years of enterprise backend experience operating serverless platforms at scale serving millions of users.
    </Fragment>
  </Hero>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Fewer tokens than JSON', amount: '79%' },
      { title: 'Comprehension accuracy', amount: '90.7%' },
      { title: 'LLM evaluations', amount: '1,700+' },
      { title: 'Merged upstream PRs', amount: '27' },
    ]}
  />

  <!-- Projects -->
  <Features
    id="projects"
    tagline="Projects"
    title="Open source infrastructure for the agentic AI stack"
    subtitle="Wire formats, code intelligence, MCP tooling, conformance testing. Everything production-grade, everything backed by data."
    items={[
      {
        title: 'GCF (Graph Compact Format)',
        description:
          'The only wire format with 100% LLM comprehension accuracy across every model tested. 71% fewer tokens than JSON, 25% fewer than TOON. 1,700+ evaluations, 10+ models, 3 providers. Six implementations, bidirectional MCP proxy, one billion fuzz-verified lossless round-trips.',
        icon: 'tabler:file-code',
        callToAction: { text: 'gcformat.com', href: 'https://gcformat.com', target: '_blank' },
      },
      {
        title: 'agent-lsp',
        description:
          'Code intelligence infrastructure for AI agents. 65 tools, 30 CI-verified languages, 24 agent workflows. Single Go binary. Uses GCF as default output format.',
        icon: 'tabler:code',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/agent-lsp', target: '_blank' },
      },
      {
        title: 'mcp-assert',
        description:
          'Conformance testing for MCP servers. 102 servers scanned, 34 bugs found, 12 upstream issues filed. ~28K downloads. Fuzz testing, schema linting.',
        icon: 'tabler:test-pipe',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/mcp-assert', target: '_blank' },
      },
      {
        title: 'knowing',
        description:
          'Self-adapting code intelligence engine. 28 MCP tools, graph-native analysis, session deduplication, content-addressed identity layer. The system GCF was extracted from.',
        icon: 'tabler:brain',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/knowing', target: '_blank' },
      },
      {
        title: 'GCF Proxy',
        description:
          'Wrap any MCP server with one command. JSON tool responses re-encoded as GCF before reaching the model. Zero code changes. Session stats track savings in real time.',
        icon: 'tabler:refresh',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/gcf-proxy', target: '_blank' },
      },
      {
        title: 'GCP Emulator Suite',
        description:
          'Local implementations of Google Cloud APIs. Secret Manager has 50K+ downloads, ranked #1 on Google/Bing/DuckDuckGo. KMS, IAM, Eventarc also available.',
        icon: 'tabler:cloud',
        callToAction: { text: 'Secret Manager', href: 'https://github.com/blackwell-systems/gcp-secret-manager-emulator', target: '_blank' },
      },
    ]}
  />

  <!-- Consulting -->
  <Content
    id="consulting"
    tagline="Consulting"
    title="Reduce the cost of running GenAI applications"
    isReversed
    items={[
      {
        title: 'GenAI Cost Reduction',
        description: 'Any application sending structured data to an LLM: RAG pipelines, agent loops, batch processing, structured outputs. 50-79% fewer tokens with better comprehension.',
      },
      {
        title: 'MCP Server Optimization',
        description: 'Audit and optimize MCP tool responses. Drop-in proxy for immediate savings or native GCF integration for session deduplication and delta encoding.',
      },
      {
        title: 'Developer Workflow',
        description: 'Developers using Claude Code, Cursor, or any AI coding tool with MCP servers pay token costs on every tool call. The proxy saves tokens across every engineering session.',
      },
    ]}
    image={{
      src: '~/assets/images/default.png',
      alt: 'Consulting',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Nobody else has this expertise</h3>
      I'm the creator of GCF and the author of the comprehension benchmark. Every claim is backed by 1,700+ published evaluations across 10+ models and 3 providers.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- How it works -->
  <Steps
    title="How it works"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Free Demo</span>',
        description:
          'Run gcf-proxy --verbose against your MCP server or any structured data pipeline. See your actual token savings in real time. Zero commitment, zero code changes.',
        icon: 'tabler:terminal',
      },
      {
        title: 'Step 2: <span class="font-medium">Pipeline Audit</span>',
        description:
          'Measure your actual token costs per tool call, per pipeline stage, per session. Deliver a before/after report with measurable savings and ROI calculation.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Step 3: <span class="font-medium">Integration</span>',
        description:
          'Native GCF encoding in your codebase. Session deduplication, delta encoding, testing, documentation. Or keep the proxy for zero-effort savings.',
        icon: 'tabler:code',
      },
      {
        title: 'Ongoing savings',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Contributions -->
  <Features
    id="contributions"
    tagline="Upstream"
    title="27 merged PRs across the ecosystem"
    subtitle="#6 contributor to mcp-go (8.7K stars). Data corruption fixes, panic recovery, SDK hardening, spec compliance, transport bugs."
    items={[
      {
        title: 'Anthropic',
        description: 'MCP Go, Python, PHP SDKs + servers (85K+ stars)',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Google',
        description: 'go-containerregistry: OCI artifact corruption fix (3.8K stars)',
        icon: 'tabler:brand-google',
      },
      {
        title: 'GitHub',
        description: 'github-mcp-server (16K stars)',
        icon: 'tabler:brand-github',
      },
      {
        title: 'LangChain',
        description: 'Text splitter fix (136K stars)',
        icon: 'tabler:link',
      },
      {
        title: 'etcd (CNCF)',
        description: 'gRPC error code fix (51K stars)',
        icon: 'tabler:database',
      },
      {
        title: 'mark3labs (mcp-go)',
        description: '9 PRs merged, #6 all-time contributor (8.7K stars)',
        icon: 'tabler:trophy',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Research Stats -->
  <Stats
    stats={[
      { title: 'Published papers', amount: '5' },
      { title: 'Open source projects', amount: '20+' },
      { title: 'GCP emulator downloads', amount: '50K+' },
      { title: 'Total ecosystem stars', amount: '172+' },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Call',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:calendar',
      },
      {
        text: 'View Projects',
        href: 'https://github.com/blackwell-systems',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">Ready to cut your AI token costs?</Fragment>

    <Fragment slot="subtitle">
      Free demo available. Run gcf-proxy against your server and see the savings before committing to anything.
    </Fragment>
  </CallToAction>
</Layout>
