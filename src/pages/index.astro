---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Steps from '~/components/widgets/Steps.astro';

const metadata = {
  title: 'Blackwell Systems — AI Infrastructure & Consulting',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Audit',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:bolt',
      },
      { text: 'View on GitHub', href: 'https://github.com/blackwell-systems', target: '_blank', icon: 'tabler:brand-github' },
    ]}
  >
    <Fragment slot="title">
      We cut your AI token costs by <span class="text-accent dark:text-white">70-95%</span>. Measurably.
    </Fragment>

    <Fragment slot="subtitle">
      The Token Optimization Stack: 7 layers of compounding cost reduction. Model routing, prompt caching, session dedup, wire format encoding, context filtering, output compression, agent loop architecture. Most teams optimize one layer. We audit all seven.
    </Fragment>
  </Hero>

  <!-- Stats -->
  <Stats
    stats={[
      { title: 'Typical combined cost reduction', amount: '70-95%' },
      { title: 'Optimization layers', amount: '7' },
      { title: 'LLM evaluations backing our data', amount: '1,700+' },
      { title: 'Lossless round-trips verified', amount: '43B+' },
    ]}
  />

  <!-- Projects -->
  <Features
    id="projects"
    tagline="Projects"
    title="Open source infrastructure for the agentic AI stack"
    subtitle="Wire formats, code intelligence, MCP tooling, conformance testing. Everything production-grade, everything backed by data."
    items={[
      {
        title: 'GCF (Graph Compact Format)',
        description:
          'The AI-native wire format for structured data. 100% LLM comprehension on every frontier model, 90.7% on adversarial payloads. 53-71% fewer tokens than JSON. 1,700+ evaluations, 10+ models, 3 providers. Six implementations, zero runtime dependencies, MCP proxy, 43 billion+ lossless round-trips across 5 formats.',
        icon: 'tabler:file-code',
        callToAction: { text: 'gcformat.com', href: 'https://gcformat.com', target: '_blank' },
      },
      {
        title: 'agent-lsp',
        description:
          'Code intelligence infrastructure for AI agents. 65 tools, 30 CI-verified languages, 24 agent workflows. Single Go binary. Uses GCF as default output format.',
        icon: 'tabler:code',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/agent-lsp', target: '_blank' },
      },
      {
        title: 'mcp-assert',
        description:
          'Conformance testing for MCP servers. 102 servers scanned, 34 bugs found, 12 upstream issues filed. ~28K downloads. Fuzz testing, schema linting.',
        icon: 'tabler:test-pipe',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/mcp-assert', target: '_blank' },
      },
      {
        title: 'knowing',
        description:
          'Self-adapting code intelligence engine. 28 MCP tools, graph-native analysis, session deduplication, content-addressed identity layer. The system GCF was extracted from.',
        icon: 'tabler:brain',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/knowing', target: '_blank' },
      },
      {
        title: 'GCF Proxy',
        description:
          'Wrap any MCP server with one command. JSON tool responses re-encoded as GCF before reaching the model. Zero code changes. Session stats track savings in real time.',
        icon: 'tabler:refresh',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/gcf-proxy', target: '_blank' },
      },
      {
        title: 'GCP Emulator Suite',
        description:
          'Local implementations of Google Cloud APIs. Secret Manager has 50K+ downloads, ranked #1 on Google/Bing/DuckDuckGo. KMS, IAM, Eventarc also available.',
        icon: 'tabler:cloud',
        callToAction: { text: 'Secret Manager', href: 'https://github.com/blackwell-systems/gcp-secret-manager-emulator', target: '_blank' },
      },
    ]}
  />

  <!-- Consulting: Token Optimization Stack -->
  <Content
    id="consulting"
    tagline="Consulting"
    title="The Token Optimization Stack"
    items={[
      {
        title: 'Layer 1: Model Routing',
        description: 'Route simple tasks to cheap models (80% savings). RouteLLM, LiteLLM, or custom classifiers. Most teams use one model for everything.',
      },
      {
        title: 'Layer 2: Transport',
        description: 'Prompt caching (90% off repeated prefix), batch API (50% off async work), request coalescing. Zero code changes on Anthropic and OpenAI.',
      },
      {
        title: 'Layer 3: Session',
        description: 'GCF session deduplication: 92% savings by the 5th call. Delta encoding: 81% on re-queries. No other format can do this.',
      },
      {
        title: 'Layer 4: Format',
        description: 'GCF wire format: 53-71% fewer tokens on structured data. 100% LLM comprehension. Drop-in proxy or native encoding in 6 languages.',
      },
      {
        title: 'Layer 5: Context',
        description: 'RAG reranking, CLI output filtering (RTK: 60-90% savings), selective tool loading. Send less irrelevant data into the context window.',
      },
      {
        title: 'Layer 6: Output',
        description: 'Effort parameter (thinking token control), structured outputs, Caveman-style compression. Output tokens cost 3-6x more than input.',
      },
      {
        title: 'Layer 7: Architecture',
        description: 'Agent loop redesign, task budgets, parallel tool execution, progressive disclosure. The loop is where all optimizations compound most aggressively.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">These layers stack multiplicatively</h3>
      A $2.28 agent session becomes $0.36 after applying routing + caching + format encoding + effort control. Each layer addresses a different source of waste. Optimizing one does not diminish the opportunity in the others.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Cost Calculator -->
  <section class="py-16 bg-white dark:bg-[#09090b]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl text-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800">
        <iframe src="https://gcformat.com/calculator-embed.html" style="width:100%; height:900px; border:none; background: transparent;" loading="lazy"></iframe>
      </div>
      <div class="mt-8">
        <a href="https://cal.com/blackwell-systems" class="inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 bg-primary-600 dark:bg-primary-500 text-white hover:bg-primary-700 dark:hover:bg-primary-400 shadow-xl shadow-primary-500/20 px-8 py-4 text-lg">
          Book a Free Audit →
        </a>
        <p class="text-sm text-slate-500 mt-3">30 minutes. We'll show you your actual savings on your real data.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <Steps
    title="How it works"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Discovery Call (30 min, free)</span>',
        description:
          'Eight questions that reveal which of the 7 layers are costing you the most. We identify your batch-eligible workload, cache hit rate, routing opportunities, and structured data percentage.',
        icon: 'tabler:phone',
      },
      {
        title: 'Step 2: <span class="font-medium">Token Audit (1-2 days)</span>',
        description:
          'Instrument one representative session. Measure total tokens per call, breakdown by category (system prompt vs history vs tool results vs output), cache hit rate, and structured data ratio. Deliver a report with projected savings per layer.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Step 3: <span class="font-medium">Implement (1-2 weeks)</span>',
        description:
          'Deploy optimizations in priority order: prompt caching (day 1), format encoding (day 2), model routing (day 3-4), output compression (day 5), agent loop redesign (week 2). Measured before/after on every change.',
        icon: 'tabler:code',
      },
      {
        title: 'Permanent cost reduction',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- Contributions -->
  <Features
    id="contributions"
    tagline="Upstream"
    title="27 merged PRs across the ecosystem"
    subtitle="#6 contributor to mcp-go (8.7K stars). Data corruption fixes, panic recovery, SDK hardening, spec compliance, transport bugs."
    items={[
      {
        title: 'Anthropic',
        description: 'MCP Go, Python, PHP SDKs + servers (85K+ stars)',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Google',
        description: 'go-containerregistry: OCI artifact corruption fix (3.8K stars)',
        icon: 'tabler:brand-google',
      },
      {
        title: 'GitHub',
        description: 'github-mcp-server (16K stars)',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Grafana',
        description: '3 PRs merged: feature + panic fix + error propagation (74K stars)',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'etcd (CNCF)',
        description: 'gRPC error code fix (51K stars)',
        icon: 'tabler:database',
      },
      {
        title: 'mark3labs (mcp-go)',
        description: '9 PRs merged, #6 all-time contributor (8.7K stars)',
        icon: 'tabler:trophy',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Research Stats -->
  <Stats
    stats={[
      { title: 'Monthly ecosystem downloads', amount: '30K+' },
      { title: 'Open source projects', amount: '20+' },
      { title: 'Upstream PRs merged', amount: '27' },
      { title: 'Published papers', amount: '5' },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Audit',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:calendar',
      },
      {
        text: 'View Projects',
        href: 'https://github.com/blackwell-systems',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">Spending $5K+/month on LLM APIs?</Fragment>

    <Fragment slot="subtitle">
      Most teams are paying 3-5x more than they need to. We audit all 7 layers, show you the math, and implement the fixes. Typical result: 70-95% cost reduction in 2 weeks.
    </Fragment>
  </CallToAction>
</Layout>
