---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Blackwell Systems: independent, evidence-first technical judgment',
  ignoreTitleTemplate: true,
};

const CAL = 'https://cal.com/blackwell-systems';
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a call',
        href: CAL,
        icon: 'tabler:bolt',
      },
      { variant: 'secondary', text: 'See services', href: '/services' },
    ]}
  >
    <Fragment slot="title">
      Independent, <span class="text-accent dark:text-white">evidence-first</span> technical judgment.
    </Fragment>

    <Fragment slot="subtitle">
      The outside read a team brings in for the calls that are hard to make from the inside: is the claim real,
      should you build or buy, what should you own, and what is it costing you. Fractional CTO, technical due
      diligence, and AI cost optimization, backed by published work and checked on your own systems, not asserted.
    </Fragment>
  </Hero>

  <!-- Social proof: GCF adoption across the ecosystem (styled after the gcf site's SocialProof) -->
  <section class="pt-4 pb-10">
    <div class="proof-wrap">
      <span class="proof-label">Teams building on GCF, my open wire format</span>
      <span class="proof-items">
        <a href="https://github.com/ChromeDevTools/chrome-devtools-mcp" target="_blank" rel="noopener" class="proof-item">Chrome DevTools MCP <span class="proof-stars">48.8K ★</span></a>
        <span class="proof-sep">·</span>
        <a href="https://github.com/diegosouzapw/OmniRoute" target="_blank" rel="noopener" class="proof-item">♦️ OmniRoute <span class="proof-stars">43.9K ★</span></a>
        <span class="proof-sep">·</span>
        <a href="https://github.com/automateyournetwork/netclaw" target="_blank" rel="noopener" class="proof-item">🦞 NetClaw <span class="proof-stars">627 ★</span></a>
        <span class="proof-sep">·</span>
        <a href="https://github.com/stevesolun/ctx" target="_blank" rel="noopener" class="proof-item">ctx <span class="proof-stars">569 ★</span></a>
        <span class="proof-sep">·</span>
        <a href="https://github.com/gensecaihq/Wazuh-MCP-Server" target="_blank" rel="noopener" class="proof-item">🛡️ Wazuh MCP <span class="proof-stars">216 ★</span></a>
        <span class="proof-sep">·</span>
        <a href="https://speakeasy.com" target="_blank" rel="noopener" class="proof-item"><img src="/logos/speakeasy-logo.svg" alt="Speakeasy" class="proof-logo invert dark:invert-0" /></a>
        <span class="proof-sep">·</span>
        <a href="https://opendataproducts.org/sdk/" target="_blank" rel="noopener" class="proof-item"><img src="/logos/odps-logo.png" alt="ODPS" class="proof-logo" /> SDK <span class="proof-stars">(Linux Foundation)</span></a>
        <span class="proof-sep">·</span>
        <a href="https://neuronest.cc/" target="_blank" rel="noopener" class="proof-item"><span class="nn-logo">🧠</span> NeuroNest</a>
        <span class="proof-sep">·</span>
        <a href="https://gcformat.com/ecosystem/adopters.html" target="_blank" rel="noopener" class="proof-item proof-more">and more</a>
      </span>
    </div>
  </section>

  <style>
    .proof-wrap {
      max-width: 1152px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .proof-label {
      font-size: 0.7rem;
      font-weight: 600;
      color: rgb(148 163 184 / 0.9);
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }
    .proof-items {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .proof-item {
      font-size: 0.8rem;
      font-weight: 600;
      color: rgb(100 116 139);
      text-decoration: none;
      transition: color 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    :global(.dark) .proof-item { color: rgb(148 163 184); }
    .proof-item:hover { color: var(--aw-color-primary, #2563eb); }
    .proof-stars {
      font-size: 0.68rem;
      color: var(--aw-color-primary, #2563eb);
      opacity: 0.75;
      font-weight: 700;
    }
    .proof-sep { color: rgb(203 213 225); font-size: 0.7rem; }
    :global(.dark) .proof-sep { color: rgb(51 65 85); }
    .proof-more { font-style: italic; opacity: 0.8; }
    .proof-logo {
      height: 14px;
      width: auto;
      display: inline;
      vertical-align: text-top;
      opacity: 0.6;
      transition: opacity 0.2s ease;
    }
    .proof-item:hover .proof-logo { opacity: 1; }
    @keyframes nn-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .nn-logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      font-size: 10px;
      border-radius: 50%;
      position: relative;
      vertical-align: middle;
    }
    .nn-logo::before {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      background: conic-gradient(#a855f7, #4ade80, #a855f7);
      animation: nn-spin 6s linear infinite;
      z-index: -1;
      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
      mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    }
  </style>

  <!-- Stats: buyer-legible traction and value at a glance -->
  <Stats
    stats={[
      { title: 'Typical token savings', amount: '70-90%' },
      { title: 'Monthly ecosystem downloads', amount: '150K+' },
      { title: 'Upstream PRs merged', amount: '40+' },
      { title: 'Open source projects', amount: '20+' },
    ]}
  />

  <!-- The offer: services + the entry door -->
  <Features
    id="services"
    tagline="How I work"
    title="One method, several ways in"
    subtitle="One method underneath everything: evidence-first, verifiable, reproducible, backed by published work and checked on your own data, not asserted. Most engagements start with an assessment and go deep where it points: fractional CTO, technical due diligence, or AI cost optimization."
    columns={3}
    items={[
      {
        title: 'Fractional CTO',
        description:
          'Embedded technical leadership: strategy and roadmap, build-versus-buy and vendor decisions, architecture, engineering process, cost, and the technical narrative for a raise. The judgment a company needs before it hires a full-time CTO.',
        icon: 'tabler:compass',
        callToAction: { text: 'Fractional CTO', href: '/services#fractional-cto' },
      },
      {
        title: 'Technical due diligence',
        description:
          'Adversarial, not demonstrative: I define what would prove a claim false, then try. Independent evaluation of a technical claim or vendor, is the advantage real, and should you buy, build, or own it, delivered as a decision memo with economics and risk.',
        icon: 'tabler:microscope',
        callToAction: { text: 'Due diligence', href: '/services#diligence' },
      },
      {
        title: 'AI cost optimization',
        description:
          'Cut your LLM bill without losing quality. A full-stack audit across techniques that compound to 70-90% savings, every number measured on your data.',
        icon: 'tabler:coin',
        callToAction: { text: 'The full stack', href: '#token-optimization' },
      },
    ]}
  />

  <!-- Business-owner entry door -->
  <CallToAction
    actions={[
      { variant: 'primary', text: 'AI Opportunity Assessment', href: '/ai-opportunity-assessment', icon: 'tabler:compass' },
    ]}
  >
    <Fragment slot="title">Run a business and just need a straight answer on AI?</Fragment>

    <Fragment slot="subtitle">
      If you are not technical and do not need a CTO, start with the AI Opportunity Assessment: a fixed-scope,
      vendor-neutral read on where AI actually fits your business and where it does not. It is the front door, and it
      feeds the three services above when the work is worth it. Plain language, nothing to sell you.
    </Fragment>
  </CallToAction>

  <!-- Evidence: the proof behind the judgment -->
  <Features
    id="projects"
    tagline="The evidence behind the judgment"
    title="Open source infrastructure for the agentic AI stack"
    subtitle="The recommendations are backed by shipped, measured work: wire formats, code intelligence, MCP tooling, conformance testing. Everything production-grade, everything backed by data."
    items={[
      {
        title: 'GCF (Graph Compact Format)',
        description:
          'The AI-native wire format for structured data. 100% LLM comprehension on every frontier model, 90.7% on adversarial payloads. 53-71% fewer tokens than JSON. 2,500+ evaluations across 11 models and 4 providers. Seven implementations, zero runtime dependencies, MCP proxy, 43 billion+ lossless round-trips across 5 formats.',
        icon: 'tabler:file-code',
        callToAction: { text: 'gcformat.com', href: 'https://gcformat.com', target: '_blank' },
      },
      {
        title: 'agent-lsp',
        description:
          'Code intelligence infrastructure for AI agents. 65 tools, 30 CI-verified languages, 24 agent workflows. Single Go binary. Uses GCF as default output format.',
        icon: 'tabler:code',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/agent-lsp', target: '_blank' },
      },
      {
        title: 'mcp-assert',
        description:
          'Conformance testing for MCP servers. 102 servers scanned, 34 bugs found, 12 upstream issues filed. ~28K downloads. Fuzz testing, schema linting.',
        icon: 'tabler:test-pipe',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/mcp-assert', target: '_blank' },
      },
      {
        title: 'knowing',
        description:
          'Self-adapting code intelligence engine. 28 MCP tools, graph-native analysis, session deduplication, content-addressed identity layer. The system GCF was extracted from.',
        icon: 'tabler:brain',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/knowing', target: '_blank' },
      },
      {
        title: 'GCF Proxy',
        description:
          'Wrap any MCP server with one command. JSON tool responses re-encoded as GCF before reaching the model. Zero code changes. Session stats track savings in real time.',
        icon: 'tabler:refresh',
        callToAction: { text: 'Repository', href: 'https://github.com/blackwell-systems/gcf-proxy', target: '_blank' },
      },
      {
        title: 'GCP Emulator Suite',
        description:
          'Local implementations of Google Cloud APIs. Secret Manager has 50K+ downloads, ranked #1 on Google/Bing/DuckDuckGo. KMS, IAM, Eventarc also available.',
        icon: 'tabler:cloud',
        callToAction: { text: 'Secret Manager', href: 'https://github.com/blackwell-systems/gcp-secret-manager-emulator', target: '_blank' },
      },
    ]}
  />

  <!-- Contributions -->
  <Features
    id="contributions"
    tagline="Upstream"
    title="40+ merged PRs across the ecosystem"
    subtitle="Bug fixes, hardening, and features merged into open-source projects across the stack. #6 all-time contributor to mcp-go."
    items={[
      {
        title: 'mcp-go',
        description: '#6 all-time contributor. 9 merged PRs: panic recovery, goroutine-leak fixes, and reliability across the SSE and stdio handlers.',
        icon: 'tabler:trophy',
      },
      {
        title: 'Model Context Protocol',
        description: 'Merged fixes across the official MCP SDKs (PHP, Python, Go): schema corrections, exception chaining, and transport handling.',
        icon: 'tabler:plug',
      },
      {
        title: 'GitHub',
        description: 'github-mcp-server: co-authored a merged contribution to the official GitHub MCP server.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Google',
        description: 'go-containerregistry: fixed OCI artifact corruption in mutate, added a round-trip test, and corrected registry name parsing.',
        icon: 'tabler:brand-google',
      },
      {
        title: 'Grafana',
        description: 'mcp-grafana: a Sift panic fix, timestamp validation, and a feature building server instructions from enabled tool categories.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'HashiCorp',
        description: 'terraform-provider-aws: handle the UnsupportedOperationException path in Directory Service so applies stop failing.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Core libraries',
        description: 'Targeted fixes to widely used projects: pip (PyPA) encoding, a testify suite panic, go-openai stream serialization, and a LangChain text-splitter bug.',
        icon: 'tabler:packages',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- GCF technical proof (closes the evidence block) -->
  <Stats
    stats={[
      { title: 'GCF comprehension (frontier models)', amount: '100%' },
      { title: 'GCF comprehension evals', amount: '2,500+' },
      { title: 'GCF implementations', amount: '7' },
      { title: 'Lossless round-trips', amount: '43B+' },
    ]}
  />

  <!-- One service in depth: AI cost optimization -->
  <Features
    id="token-optimization"
    tagline="A service in depth: AI cost optimization"
    title="The Token Optimization Stack"
    subtitle="Take one of the services in depth. Seven layers of compounding cost reduction, each measured on your own pipeline. They stack multiplicatively: a $2.28 agent session becomes $0.36 after routing, caching, format encoding, and effort control."
    columns={3}
    items={[
      {
        title: 'Layer 1: Model Routing',
        description: 'Route simple tasks to cheap models (80% savings). RouteLLM, LiteLLM, or custom classifiers. Most teams use one model for everything.',
        icon: 'tabler:arrows-sort',
      },
      {
        title: 'Layer 2: Transport',
        description: 'Prompt caching (90% off repeated prefix), batch API (50% off async work), request coalescing. Zero code changes on Anthropic and OpenAI.',
        icon: 'tabler:arrows-exchange',
      },
      {
        title: 'Layer 3: Session',
        description: 'GCF session deduplication: 92% savings by the 5th call. Delta encoding: 81% on re-queries. No other format can do this.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Layer 4: Format',
        description: 'GCF wire format: 53-71% fewer tokens on structured data. 100% LLM comprehension. Drop-in proxy or native encoding in 7 languages.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Layer 5: Context',
        description: 'RAG reranking, CLI output filtering (RTK: 60-90% savings), selective tool loading. Send less irrelevant data into the context window.',
        icon: 'tabler:search',
      },
      {
        title: 'Layer 6: Output',
        description: 'Effort parameter (thinking token control), structured outputs, Caveman-style compression. Output tokens cost 3-6x more than input.',
        icon: 'tabler:arrows-minimize',
      },
      {
        title: 'Layer 7: Architecture',
        description: 'Agent loop redesign, task budgets, parallel tool execution, progressive disclosure. The loop is where all optimizations compound most aggressively.',
        icon: 'tabler:topology-star',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- How the cost-optimization engagement runs -->
  <Features
    id="how-it-works"
    tagline="AI cost optimization: how it works"
    title="The path to permanent cost reduction"
    subtitle="A short call, a focused audit, then implementation, measured before and after on every change, in about two weeks."
    columns={3}
    items={[
      {
        title: 'Step 1: Discovery call (30 min, free)',
        description:
          'Eight questions that reveal which of the 7 layers are costing you the most. We identify your batch-eligible workload, cache hit rate, routing opportunities, and structured data percentage.',
        icon: 'tabler:phone',
      },
      {
        title: 'Step 2: Token audit (1-2 days)',
        description:
          'Instrument one representative session. Measure total tokens per call, breakdown by category (system prompt vs history vs tool results vs output), cache hit rate, and structured data ratio. Deliver a report with projected savings per layer.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Step 3: Implement (1-2 weeks)',
        description:
          'Deploy optimizations in priority order: prompt caching (day 1), format encoding (day 2), model routing (day 3-4), output compression (day 5), agent loop redesign (week 2). Measured before/after on every change.',
        icon: 'tabler:code',
      },
    ]}
  />

  <!-- Cost Calculator: the free number, right before the ask -->
  <section class="py-16 bg-white dark:bg-[#09090b]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl text-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800">
        <iframe src="https://gcformat.com/calculator-embed.html" style="width:100%; height:900px; border:none; background: transparent;" loading="lazy"></iframe>
      </div>
      <div class="mt-8">
        <a href={CAL} class="inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 bg-primary-600 dark:bg-primary-500 text-white hover:bg-primary-700 dark:hover:bg-primary-400 shadow-xl shadow-primary-500/20 px-8 py-4 text-lg">
          Book a Free Audit →
        </a>
        <p class="text-sm text-slate-500 mt-3">30 minutes. We'll show you your actual savings on your real data.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a call',
        href: CAL,
        icon: 'tabler:calendar',
      },
      {
        text: 'See services',
        href: '/services',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Need an outside technical read?</Fragment>

    <Fragment slot="subtitle">
      Whether you want a plain-language read on where AI fits your business, a full-time-CTO-level call, a vendor or
      claim to verify, or an LLM bill that is too high, the work is the same: independent judgment, backed by
      published evidence and checked on your own data. Book a call and tell me the question.
    </Fragment>
  </CallToAction>
</Layout>
