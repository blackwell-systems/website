---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services — Blackwell Systems',
  description:
    'Independent, evidence-first technical judgment for AI systems: fractional CTO, technical due diligence, and AI cost optimization. Every recommendation backed by published evaluations and verifiable on your own data.',
};

const CAL = 'https://cal.com/blackwell-systems';
---

<Layout metadata={metadata}>
  <Hero
    tagline="Services"
    actions={[
      { variant: 'primary', text: 'Book a call', href: CAL, icon: 'tabler:bolt' },
      { variant: 'secondary', text: 'Get in touch', href: '/contact' },
    ]}
  >
    <Fragment slot="title">
      Independent technical judgment for your <span class="text-accent dark:text-white">AI stack</span>.
    </Fragment>

    <Fragment slot="subtitle">
      The outside technical read a team brings in to answer three questions: is it real, should you build or
      buy it, and what is it costing you. Fractional CTO, technical due diligence, and AI cost optimization,
      each backed by published evidence and verifiable on your own data.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'Published LLM evaluations', amount: '1,700+' },
      { title: 'GCF implementations', amount: '6' },
      { title: 'Languages shipped', amount: '6' },
      { title: 'Typical token savings', amount: '70-90%' },
    ]}
  />

  <!-- The three services -->
  <Features
    id="services"
    tagline="How I work"
    title="Three services, one method"
    subtitle="One method underneath all three: evidence-first, verifiable, reproducible. Every recommendation is backed by published work and checked on your own data, not asserted."
    columns={3}
    items={[
      {
        title: 'Fractional CTO (AI)',
        description:
          'Embedded technical leadership for AI-heavy teams: strategy and roadmap, build-versus-buy and vendor decisions, architecture, engineering process, AI cost, and the technical narrative for a raise. The judgment a company needs before it hires a full-time CTO.',
        icon: 'tabler:compass',
        callToAction: { text: 'Fractional CTO', href: '#fractional-cto' },
      },
      {
        title: 'Technical due diligence (AI)',
        description:
          'Independent evaluation of an AI claim or vendor: is the advantage real, and should you buy, build, or own it. Two reinforcing methods, a claim-verification engine and a vendor-evaluation framework, delivered as a decision memo with economics and risk.',
        icon: 'tabler:microscope',
        callToAction: { text: 'Due diligence', href: '#diligence' },
      },
      {
        title: 'AI cost optimization',
        description:
          'Cut your LLM bill without losing quality. A full-stack audit across ten techniques that compound to 70-90% savings, every number measured on your data.',
        icon: 'tabler:coin',
        callToAction: { text: 'The full stack', href: '#token-optimization' },
      },
    ]}
  />

  <!-- Fractional CTO -->
  <Features
    id="fractional-cto"
    tagline="Fractional CTO"
    title="The judgment before the full-time hire"
    subtitle="Brought in as a service, a few hours a week or for a defined project. CTO-level decisions without the full-time cost, with honest scope: I own the technical calls and guide your team, and I am direct about what is decision work versus hands-on build."
    columns={3}
    items={[
      {
        title: 'Strategy and roadmap',
        description: 'Align the technical direction to the business, set the roadmap, and make the big architecture calls.',
        icon: 'tabler:map',
      },
      {
        title: 'Build, buy, or own',
        description: 'Evaluate technologies and vendors, run build-versus-buy, and decide what to own versus rent.',
        icon: 'tabler:scale',
      },
      {
        title: 'Architecture and scale',
        description: 'System design, reliability, security posture, and paying down the tech debt that slows delivery.',
        icon: 'tabler:topology-star',
      },
      {
        title: 'AI systems and cost',
        description: 'AI strategy, model and vendor selection, and keeping the AI bill sane as you scale.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Team and process',
        description: 'Engineering process, hiring guidance, and leveling up the people you already have.',
        icon: 'tabler:users',
      },
      {
        title: 'Fundraising support',
        description: 'The technical narrative for a raise, and answering investor technical due diligence from the technical seat.',
        icon: 'tabler:presentation',
      },
    ]}
  />

  <!-- Technical due diligence -->
  <Features
    id="diligence"
    tagline="Technical due diligence"
    title="Is the claim real. Should you buy, build, or own it."
    subtitle="Independent, from public materials unless you grant access, with no stake in the vendor. Every finding traces to evidence and reproduces."
    columns={2}
    items={[
      {
        title: 'Claim verification (the engine)',
        description:
          'For computational-advantage and compute-primitive claims: independent ground truth, classical-solver baselines, and a battery covering attribution, determinism, mechanism, scaling, fair comparison, and correctness. Does the advantage actually hold.',
        icon: 'tabler:microscope',
      },
      {
        title: 'Vendor evaluation (the method)',
        description:
          'For a buy-or-build decision on an AI product: the real peer class, the same-task comparison the vendor avoids, mechanism versus model, and the own-versus-rent economics.',
        icon: 'tabler:checklist',
      },
      {
        title: 'What you get',
        description:
          'A decision memo with a clear recommendation, a rent-versus-build cost model, a risk register, and a methodology note stating scope and confidence. Written to be acted on.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Independence',
        description:
          'Public materials, no stake, and a standing commitment to revise on new evidence. The assessment is worth paying for because it is not sold to a conclusion.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- AI cost optimization: the ten techniques -->
  <Features
    id="token-optimization"
    tagline="AI cost optimization"
    title="10 techniques that compound multiplicatively"
    subtitle="Most tools optimize one layer. I diagnose which layers matter for your pipeline and implement the full stack."
    columns={3}
    items={[
      {
        title: 'Prompt Caching',
        description: 'Restructure prompts for provider-native caching. 90% savings on cached tokens (Anthropic), 50% (OpenAI). Most teams leave this unconfigured.',
        icon: 'tabler:database',
      },
      {
        title: 'Wire Format Compression',
        description: 'GCF encodes structured data with 61-71% fewer tokens than JSON. Drop-in proxy for zero-code adoption, or native integration for session dedup.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Model Routing',
        description: 'Route simple tasks to cheap models, complex tasks to expensive ones. 50-80% cost reduction depending on your query mix.',
        icon: 'tabler:arrows-sort',
      },
      {
        title: 'RAG Optimization',
        description: 'Rerank before injection, tune chunk sizes, encode retrieval results. Most teams retrieve 10-20 chunks when 3-5 would suffice.',
        icon: 'tabler:search',
      },
      {
        title: 'Batch API',
        description: '50% discount on any workload that can tolerate 24-hour latency. Classification, extraction, content generation. Free money.',
        icon: 'tabler:stack-2',
      },
      {
        title: 'Agent Loop Optimization',
        description: 'Batch tool calls, progressive disclosure, reasoning effort control. Reduce 15 tool calls to 5 with better tool design.',
        icon: 'tabler:repeat',
      },
      {
        title: 'Session Deduplication',
        description: 'Track what data the model has already seen. GCF session dedup makes call five 92% smaller than call one.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Prompt Engineering',
        description: 'Stable prefix design for cache hits, system prompt compression, instruction dedup, few-shot pruning. 30-50% savings from a one-time audit.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Semantic Caching',
        description: 'Cache responses for semantically similar queries. 100% savings on cache hits. GPTCache, Upstash, or custom.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Output Compression',
        description: 'Control reasoning effort via provider APIs (30-70% fewer output tokens). Structured output constraints. Response format optimization.',
        icon: 'tabler:arrows-minimize',
      },
    ]}
  />

  <!-- How the math works -->
  <Steps
    title="How the savings compound"
    tagline="Multiplicative, not additive"
    items={[
      {
        title: 'Base cost: $1.00 per session',
        description: 'Your current cost with no optimization. JSON payloads, no caching, one model, full context on every call.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'After prompt caching: $0.40',
        description: '60% of your tokens are the cached prefix (system prompt, tool schemas). Anthropic charges 10% on cached tokens.',
        icon: 'tabler:database',
      },
      {
        title: 'After wire format compression: $0.16',
        description: 'GCF reduces the remaining structured data by 61%. Tool responses, RAG results, batch payloads.',
        icon: 'tabler:file-code',
      },
      {
        title: 'After model routing: $0.05',
        description: '70% of calls routed to a model that costs 80% less. Same quality on simple tasks.',
        icon: 'tabler:arrows-sort',
      },
      {
        title: 'After batch API: $0.03',
        description: 'Async workloads moved to batch processing at 50% discount. Your optimized cost per session.',
        icon: 'tabler:check',
      },
    ]}
  />

  <!-- AI cost optimization tiers -->
  <Features
    id="tiers"
    tagline="Engagement model"
    title="Start with a demo. Go as deep as the savings justify."
    columns={2}
    items={[
      {
        title: 'Free Demo (30 min)',
        description:
          'We run gcf-proxy against one of your MCP servers, live, on your data. You see per-call token savings in real time. Walk away with a number. Zero commitment.',
        icon: 'tabler:terminal',
        callToAction: { text: 'Book a demo', href: CAL },
      },
      {
        title: 'Token Cost Audit',
        description:
          'Full pipeline analysis across all 10 techniques. We instrument your pipeline, measure token flow, and deliver a report with per-source savings, prioritized roadmap, and 12-month cost projection.',
        icon: 'tabler:report-analytics',
        callToAction: { text: 'Book a call', href: CAL },
      },
      {
        title: 'Implementation',
        description:
          'We deploy the optimizations from the audit. Prompt restructuring, proxy deployment, model routing, RAG reranking, agent loop redesign. Measured before/after on every change.',
        icon: 'tabler:rocket',
        callToAction: { text: 'Book a call', href: CAL },
      },
      {
        title: 'Native GCF Integration',
        description:
          'For teams that want maximum savings. GCF library integrated into your serialization layer, session dedup and delta encoding across agent loops, conformance tests against your data. Unlocks 92%+ savings on multi-turn sessions.',
        icon: 'tabler:code',
        callToAction: { text: 'Book a call', href: CAL },
      },
    ]}
  />

  <!-- Why Blackwell Systems -->
  <Features
    id="why"
    tagline="Why Blackwell Systems"
    title="Evidence you can check"
    columns={3}
    items={[
      {
        title: 'Built the format',
        description: 'GCF is our format. Six implementations, formal spec, 33 billion+ lossless round-trips across 5 formats and 6 languages.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Proved it works',
        description: '1,700+ LLM evaluations across 10+ models and 3 providers. 100% comprehension accuracy on every frontier model. Published methodology, published logs.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Independent by default',
        description: 'The recommendation is not sold to a conclusion. I advise prompt caching, model routing, and batch APIs even though I do not sell them, and diligence is run from public materials with no stake in the vendor.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Calculator section -->
  <section class="py-16 bg-white dark:bg-[#09090b]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl text-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800" style="min-height: 1000px;">
        <iframe src="https://gcformat.com/calculator-embed.html" style="width:100%; height:1000px; border:none; background: transparent;" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book a call', href: CAL, icon: 'tabler:calendar' },
      { variant: 'secondary', text: 'Get in touch', href: '/contact' },
    ]}
  >
    <Fragment slot="title">Bring in an outside technical read.</Fragment>

    <Fragment slot="subtitle">
      A short call, or send the details. Independent, evidence-first, and honest about what is worth building.
    </Fragment>
  </CallToAction>
</Layout>
