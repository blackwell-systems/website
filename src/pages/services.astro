---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services — Blackwell Systems',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Services"
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Demo',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:bolt',
      },
    ]}
  >
    <Fragment slot="title">
      Reduce your AI token costs. <span class="text-accent dark:text-white">Measurably.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Four tiers of engagement, from a free 30-minute demo to native format integration.
      Every recommendation backed by 1,700+ published LLM evaluations. Every claim verifiable on your own data.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'Fewer tokens for structured payloads', amount: '71%' },
      { title: 'Comprehension accuracy', amount: '100%' },
      { title: 'LLM evaluations', amount: '1,700+' },
      { title: 'Saved per year', amount: '$61K+' },
    ]}
  />

  <!-- Service Tiers -->
  <Features
    id="tiers"
    tagline="How we work"
    title="Four tiers, one goal: cut your token bill"
    subtitle="Start with a free demo. Go as deep as the savings justify."
    columns={2}
    items={[
      {
        title: 'Free Demo (30 min)',
        description:
          'We run gcf-proxy against one of your MCP servers, live, on your data. You see per-call token savings in real time. Walk away with a number. Zero commitment, zero code changes.',
        icon: 'tabler:terminal',
        callToAction: { text: 'Book a Demo', href: 'https://cal.com/blackwell-systems' },
      },
      {
        title: 'Token Cost Audit',
        description:
          'Full pipeline analysis. We measure token flow across every LLM call site: MCP tool responses, RAG context, system prompts, output. You get a written report with per-source savings, a prioritized roadmap, and a 12-month cost projection.',
        icon: 'tabler:report-analytics',
        callToAction: { text: 'Book a Call', href: 'https://cal.com/blackwell-systems' },
      },
      {
        title: 'Implementation',
        description:
          'We deploy the optimizations from the audit. gcf-proxy across your MCP servers, prompt caching configuration, model routing, session deduplication, RAG reranking. Measured before/after on every change.',
        icon: 'tabler:rocket',
        callToAction: { text: 'Book a Call', href: 'https://cal.com/blackwell-systems' },
      },
      {
        title: 'Native GCF Integration',
        description:
          'For teams that want GCF in their codebase, not just a proxy. We integrate the GCF library directly into your serialization layer, implement session dedup and delta encoding, and build conformance tests against your actual data shapes. Unlocks 92%+ savings on multi-turn sessions.',
        icon: 'tabler:code',
        callToAction: { text: 'Book a Call', href: 'https://cal.com/blackwell-systems' },
      },
    ]}
  />

  <!-- What the audit covers -->
  <Steps
    title="What the audit covers"
    tagline="Token Cost Audit"
    items={[
      {
        title: 'Input format compression',
        description: 'Run gcf-proxy against every MCP server. Measure JSON vs GCF token counts on your actual payloads. 61-71% savings typical.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Prompt caching',
        description: 'Check if your prompts are structured for provider-native caching. Anthropic offers 90% savings on cached tokens, OpenAI 50%. Many teams leave this unconfigured.',
        icon: 'tabler:database',
      },
      {
        title: 'Model selection',
        description: 'Are you running Opus on Haiku tasks? We identify which calls can be routed to cheaper models without quality loss.',
        icon: 'tabler:arrows-sort',
      },
      {
        title: 'Session deduplication',
        description: 'In multi-turn agent sessions, the same data gets retransmitted on every call. GCF session dedup sends bare references for known symbols. 92% savings by the 5th call.',
        icon: 'tabler:refresh',
      },
      {
        title: 'RAG optimization',
        description: 'Chunk sizing, reranking, and context injection strategy. Most teams retrieve too many chunks. Reranking before injection cuts tokens while improving answer quality.',
        icon: 'tabler:search',
      },
      {
        title: 'Agent loop efficiency',
        description: 'Unnecessary tool calls, missing batching, redundant reads. We analyze your agent loop and identify where tokens are wasted on round-trip overhead.',
        icon: 'tabler:repeat',
      },
    ]}
  />

  <!-- Why us -->
  <Features
    id="why"
    tagline="Why Blackwell Systems"
    title="Nobody else has this expertise"
    columns={3}
    items={[
      {
        title: 'Built the format',
        description: 'GCF is our format. Six implementations, formal spec, 1 billion+ lossless round-trips. We know every edge case.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Proved it works',
        description: '1,700+ LLM evaluations across 10+ models and 3 providers. 100% comprehension accuracy. Published methodology, published logs.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Vendor-neutral recommendations',
        description: 'We recommend prompt caching, model routing, and RAG optimization even though we don\'t sell those. The audit is about your savings, not our tools.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Calculator section -->
  <section class="py-16 bg-white dark:bg-[#09090b]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl text-center">
      <div class="rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800" style="min-height: 1000px;">
        <iframe src="https://gcformat.com/calculator-embed.html" style="width:100%; height:1000px; border:none; background: transparent;" loading="lazy"></iframe>
      </div>
    </div>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Book a Free Demo',
        href: 'https://cal.com/blackwell-systems',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title">Ready to see your savings?</Fragment>

    <Fragment slot="subtitle">
      30 minutes. We run gcf-proxy on your data. You see the numbers. No commitment.
    </Fragment>
  </CallToAction>
</Layout>
