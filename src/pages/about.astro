---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'About — Blackwell Systems',
  description:
    'Blackwell Systems is the practice of Dayna Blackwell: AI infrastructure built and proven in the open, and the evidence-first technical judgment that comes from it.',
};

const CAL = 'https://cal.com/blackwell-systems';
---

<Layout metadata={metadata}>
  <Hero
    tagline="About"
    actions={[
      { variant: 'primary', text: 'See services', href: '/services', icon: 'tabler:bolt' },
      { variant: 'secondary', text: 'Get in touch', href: '/contact' },
    ]}
  >
    <Fragment slot="title">
      I build the systems, then <span class="text-accent dark:text-white">publish the proof</span>.
    </Fragment>

    <Fragment slot="subtitle">
      Blackwell Systems is my practice. I design and ship AI infrastructure in the open, measure it, and
      document the results. Then I bring that same evidence-first standard to the technical decisions other
      teams need to get right.
    </Fragment>
  </Hero>

  <Stats
    stats={[
      { title: 'GCF implementations', amount: '7' },
      { title: 'Upstream PRs merged', amount: '27' },
      { title: 'Published papers', amount: '5' },
      { title: 'Monthly ecosystem downloads', amount: '150K+' },
    ]}
  />

  <!-- Principle -->
  <Content
    id="how-i-work"
    tagline="How I work"
    title="Evidence over assertion"
    items={[
      {
        title: 'Built in the open',
        description: 'The infrastructure is public, the benchmarks ship with their methodology and logs, and the numbers reproduce.',
      },
      {
        title: 'Verified on your data',
        description: 'When I advise, the recommendation is held to the same bar: measured on your own systems, not asserted from a template.',
      },
      {
        title: 'Clear about the edges',
        description: 'I state what a finding rests on and what would change it. Neutral by default, and direct about what is worth building.',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Most technical claims are hard to check. My work is the opposite: everything I put forward is something
        I can show you. That is the through-line from the code to the advisory work.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- What I build -->
  <Features
    id="what-i-build"
    tagline="What I build"
    title="Infrastructure for the agentic AI stack"
    subtitle="Production-grade, open source, and backed by data. This is the evidence behind the judgment."
    columns={3}
    items={[
      {
        title: 'Wire formats and infrastructure',
        description:
          'GCF, the AI-native wire format for structured data: seven implementations, published comprehension benchmarks, 53-71% fewer tokens than JSON. Plus agent-lsp, a zero-code GCF proxy, and a suite of Google Cloud emulators.',
        icon: 'tabler:file-code',
      },
      {
        title: 'Open source and upstream',
        description:
          '27 merged pull requests across the ecosystem, Anthropic, Google, GitHub, Grafana, etcd, including data-corruption and panic-recovery fixes. #6 all-time contributor to mcp-go.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Research and writing',
        description:
          'Published papers on the theory behind the tooling, and a technical blog that documents the work in depth at blog.blackwell-systems.com.',
        icon: 'tabler:notebook',
      },
    ]}
  />

  <!-- The practice -->
  <Content
    id="practice"
    tagline="The practice"
    title="The same judgment, applied to your stack"
    isReversed
    items={[
      {
        title: 'Fractional CTO',
        description: 'Embedded technical leadership: strategy, build-versus-buy, architecture, and cost.',
      },
      {
        title: 'Technical due diligence',
        description: 'Independent evaluation of a claim or vendor, delivered as a decision memo with economics and risk.',
      },
      {
        title: 'AI cost optimization',
        description: 'A full-stack audit that cuts the LLM bill without losing quality, every number measured on your data.',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Three services, one method. The full breakdown, with how each engagement runs, is on the
        <a class="text-primary-600 dark:text-primary-400 underline" href="/services">services page</a>.
      </p>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Book a call', href: CAL, icon: 'tabler:calendar' },
      { text: 'Get in touch', href: '/contact', icon: 'tabler:arrow-right' },
    ]}
  >
    <Fragment slot="title">Want an outside technical read?</Fragment>

    <Fragment slot="subtitle">
      Tell me what you are weighing and I will give you an independent, evidence-first answer.
    </Fragment>
  </CallToAction>
</Layout>
